# ─────────────────────────────────────────────────────────────
# AirSwift server environment
# Copy this file to `server/.env` and fill in real values.
# The Docker stack will NOT boot without JWT_SECRET / REFRESH_TOKEN_SECRET.
# ─────────────────────────────────────────────────────────────

# Database — for docker-compose this is overridden to point at the `db` service.
# For local (non-docker) runs, point at your local Postgres.
# In production (e.g. Neon), use the provided connection string and add
# `?sslmode=require`, e.g. postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/flightdb"

# Auth (required — server exits on boot if these are missing)
JWT_SECRET="change_me_to_a_long_random_string"
REFRESH_TOKEN_SECRET="change_me_to_another_long_random_string"
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_EXPIRES_IN="7d"
JWT_EXPIRES_IN_SECONDS=3600
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800

# Server
PORT=5000
NODE_ENV=development
# In docker-compose this is set to http://localhost:3000
CORS_ORIGIN="http://localhost:3000"

# Redis (flight-search cache). In docker-compose REDIS_URL is set to redis://redis:6379.
REDIS_URL="redis://localhost:6379"
REDIS_CACHE_TTL=300

# Amadeus API
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Firebase Admin SDK (service account fields)
FIREBASE_TYPE="service_account"
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_CLIENT_ID=""
FIREBASE_AUTH_URI="https://accounts.google.com/o/oauth2/auth"
FIREBASE_TOKEN_URI="https://oauth2.googleapis.com/token"
FIREBASE_AUTH_PROVIDER_X509_CERT_URL="https://www.googleapis.com/oauth2/v1/certs"
FIREBASE_CLIENT_X509_CERT_URL=""
